NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Optional explicit function endpoint; defaults to SUPABASE_URL/functions/v1/biz-api.
NEXT_PUBLIC_BIZ_API_URL=
# /repository-name for a GitHub project Pages site, empty for a custom domain.
NEXT_PUBLIC_BASE_PATH=
# Development only. Production builds require this to be false.
NEXT_PUBLIC_LOCAL_MODE=false
