BIZ_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_SESSION_POOLER:5432/postgres?sslmode=require
ALLOWED_ORIGINS=https://YOUR_USERNAME.github.io
# Supabase injects SUPABASE_URL and SUPABASE_ANON_KEY on hosted functions.
# Never deploy BIZ_LOCAL_DEV_USER. scripts/serve_functions.sh sets it locally only.
